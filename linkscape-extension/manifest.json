{
  "manifest_version": 3,
  "name": "Linkscape — Page Link Collector",
  "version": "1.1.0",
  "description": "Collect, separate same-site from off-site links, copy, and export links from the current page.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Collect links from this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
