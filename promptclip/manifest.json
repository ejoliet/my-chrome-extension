{
  "manifest_version": 3,
  "name": "PromptClip",
  "version": "0.1.0",
  "description": "One click converts the current page to clean Markdown for pasting into LLMs.",
  "action": {
    "default_title": "PromptClip",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [],
  "commands": {
    "clip-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open PromptClip for the current page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
