{
  "manifest_version": 3,
  "name": "Still Companion",
  "short_name": "Still",
  "version": "1.0.2",
  "description": "A quiet, local-first RSS reader with one-click feed discovery.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Find feeds with Still"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
